# Copy to terraform.tfvars (git-ignored). Not secret, but environment-specific.
account_id       = "<CLOUDFLARE_ACCOUNT_ID>"
zone_id          = "<PIVIKI_FI_ZONE_ID>"
access_team_name = "<zero-trust-team-name>"
librarian_emails = ["founder-one@example.org", "founder-two@example.org"]

# Set to the existing One-time PIN login method id if the account already has one.
# otp_identity_provider_id = "<id>"

# Flip to true only after the first librarian is seeded over SSH.
public_records_enabled = false
