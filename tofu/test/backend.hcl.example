# Copy to backend.hcl (git-ignored) and fill in the account id. Test's own key; production's
# state is tofu/prod/terraform.tfstate and test never reads it.
bucket    = "piviki-private-eu"
key       = "tofu/test/terraform.tfstate"
endpoints = { s3 = "https://<CLOUDFLARE_ACCOUNT_ID>.eu.r2.cloudflarestorage.com" }
